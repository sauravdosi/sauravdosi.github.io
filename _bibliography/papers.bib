@misc{Dosi2026IntelX,
author = {Dosi, Saurav and Kadosh, Itay and Xiang, Yu},
title = {IntelX: Autonomous Indoor Exploration via Local Coverage Gain Prediction and Structure-Aware Planning},
year = {2026},
note = {Under review},
abbr = {arXiv},
abstract = {IntelX is an autonomous indoor exploration framework that, instead of completing the unseen map with a generative model, predicts how much new area each nearby goal would reveal. A single lightweight U-Net regresses this coverage gain densely over a 20 m robot-frame occupancy window in 8.1 ms, supervised by a simulation oracle that measures the coverage each reachable goal actually yields. Junctions show up in the same field as multi-peaked angular structure, which a global planner turns into branches that it clears weakest-first. On three held-out floor plans and three out-of-distribution corpora, IntelX reaches 99 percent coverage on large maps with paths at least 20 percent shorter than every baseline that also gets there.},
code = {https://github.com/IRVLUTD/IntelX},
docs = {https://irvlutd.github.io/IntelX/docs/},
demo = {https://irvlutd.github.io/IntelX/#demo},
video = {https://irvlutd.github.io/IntelX/#video},
website = {https://irvlutd.github.io/IntelX/},
preview = {https://irvlutd.github.io/IntelX/static/img/fig1_overview.webp},
selected = {true}
}

@article{Tan2026D3Recovery,
author = {Tan, Wanbin and Dosi, Saurav and Shabani Sichani, Soroush and Li, Yixin and Wang, Zipai and Petersen, Eric and Zeng, Xinjie and Qi, Jinyi and Goldan, Amir H.},
title = {Inter-Crystal Scatter Recovery of a Light-Sharing Depth-Encoding Prism-PET Prototype Scanner Using a Diffusion Model},
journal = {Medical Physics},
volume = {53},
number = {9},
pages = {e70661},
year = {2026},
month = {sep},
publisher = {Wiley},
doi = {10.1002/mp.70661},
pmid = {42740403},
abstract = {Inter-crystal scattering (ICS) is a fundamental limitation in ultra-high resolution PET, particularly in light-sharing detectors with small crystal elements, where Compton scatter across neighboring crystals obscures the initial interaction position and degrades spatial resolution, contrast, and quantitative accuracy. This work develops and experimentally validates a scanner-level ICS recovery framework for a light-sharing depth-encoding Prism-PET prototype scanner. We build a training dataset by combining scanner-level simulations with experimental measurements, and propose D3Recovery, a diffusion-driven, physics-informed tripartite framework that estimates the 3D position and deposited energy of the initial interaction from 8x8 SiPM signal patterns. D3Recovery reaches 70.1 percent crystal identification accuracy for ICS events, improves DOI estimation to 3.6 mm FWHM, and halves mean crystal localization error versus center-of-gravity positioning (2.18 mm to 0.99 mm). On Derenzo and Hoffman brain phantoms it improves peak-to-valley ratio, MAE, SSIM and noise, retaining roughly 70 percent of otherwise discarded coincidences for a better resolution-sensitivity balance in low-dose imaging.},
video = {https://xeilwcm.github.io/D3Recovery/#video},
website = {https://xeilwcm.github.io/D3Recovery/},
preview = {https://xeilwcm.github.io/D3Recovery/static/images/overview_poster.webp},
bibtex_show = {true},
abbr = {Med Phys},
selected = {true}
}

