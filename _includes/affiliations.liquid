<div class="affiliations">
  <style>
    .affiliations {
      margin: 2rem 0 2.5rem;
    }
    .affiliations-track {
      display: grid;
      grid-template-columns: repeat({{ site.data.affiliations | size }}, minmax(0, 1fr));
      /* room for the two-line role pill that appears on hover */
      padding-bottom: 2.75rem;
    }
    .affiliation {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0 0.25rem;
      color: var(--global-text-color);
    }
    .affiliation:hover {
      text-decoration: none;
      color: var(--global-text-color);
    }
    /* each item draws its own piece of the journey line, so the line also
       spans the whole row when it scrolls sideways on smaller screens */
    .affiliation::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 26px;
      border-top: 1px solid var(--global-divider-color);
    }
    .affiliation:first-child::before {
      left: 50%;
    }
    .affiliation:last-child::before {
      right: 50%;
    }
    .affiliation-logo {
      position: relative;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--global-bg-color);
      border: 1px solid var(--global-divider-color);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.2s ease-in-out;
    }
    /* white disc keeps dark logos readable in dark mode */
    .affiliation-logo img {
      width: 42px;
      height: 42px;
      padding: 3px;
      object-fit: contain;
      border-radius: 50%;
      background: #fff;
    }
    .affiliation-logo .initials {
      font-size: 0.8rem;
      font-weight: bold;
    }
    .affiliation-dot {
      position: absolute;
      right: -1px;
      bottom: -1px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 2px solid var(--global-bg-color);
    }
    .affiliation-dot.research,
    .affiliations-legend .research {
      background: var(--global-theme-color);
    }
    .affiliation-dot.industry,
    .affiliations-legend .industry {
      background: #1d9e75;
    }
    .affiliation-name {
      font-size: 0.75rem;
      font-weight: bold;
      line-height: 1.25;
      white-space: nowrap;
      margin-top: 0.4rem;
    }
    .affiliation-years {
      font-size: 0.7rem;
      white-space: nowrap;
      color: var(--global-text-color-light);
    }
    /* the role floats below the item as exactly two unwrapped lines */
    .affiliation-role {
      position: absolute;
      top: 100%;
      left: 50%;
      z-index: 1;
      font-size: 0.68rem;
      line-height: 1.25;
      white-space: nowrap;
      margin-top: 0.3rem;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      color: var(--global-theme-color);
      border: 1px solid var(--global-theme-color);
      background: var(--global-bg-color);
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, -4px);
      transition:
        opacity 0.2s ease-in-out,
        transform 0.2s ease-in-out;
    }
    .affiliation-role span {
      display: block;
    }
    .affiliation:hover .affiliation-logo,
    .affiliation:focus-visible .affiliation-logo {
      border-color: var(--global-theme-color);
    }
    .affiliation:hover .affiliation-role,
    .affiliation:focus-visible .affiliation-role {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    .affiliations-legend {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
      font-size: 0.7rem;
      color: var(--global-text-color-light);
      margin-top: 0.25rem;
    }
    .affiliations-legend span span {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 0.3rem;
    }
    /* below laptop width the columns get too narrow for one-line names,
       so the row becomes a strip you can swipe sideways */
    @media (max-width: 991px) {
      .affiliations-track {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
      }
      .affiliation {
        flex: 0 0 auto;
        min-width: 96px;
        padding: 0 0.6rem;
        scroll-snap-align: start;
      }
    }
    /* touch screens have no hover, so skip the role and its space */
    @media (hover: none) {
      .affiliations-track {
        padding-bottom: 0.5rem;
      }
      .affiliation-role {
        display: none;
      }
    }
  </style>
  <div class="affiliations-track">
    {% for org in site.data.affiliations %}
      <a class="affiliation" href="{{ org.url }}" target="_blank" rel="noopener">
        <div class="affiliation-logo">
          {% if org.logo %}
            <img src="{{ org.logo | prepend: '/assets/img/affiliations/' | relative_url }}" alt="{{ org.name }} logo" loading="lazy">
          {% else %}
            <span class="initials">{{ org.initials }}</span>
          {% endif %}
          <span class="affiliation-dot {{ org.type }}"></span>
        </div>
        <div class="affiliation-name">{{ org.short | default: org.name }}</div>
        <div class="affiliation-years">{{ org.years }}</div>
        <div class="affiliation-role">
          {%- for line in org.role -%}<span>{{ line }}</span>{%- endfor -%}
        </div>
      </a>
    {% endfor %}
  </div>
  <div class="affiliations-legend">
    <span><span class="research"></span>Research and Academia</span>
    <span><span class="industry"></span>Industry</span>
  </div>
</div>
