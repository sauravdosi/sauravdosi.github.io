<div class="news">
  <style>
    .news-badge {
      background-color: var(--global-theme-color);
    }
    .news-scroll {
      max-height: 12rem; /* fallback until the script measures the first 3 rows */
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--global-theme-color) transparent;
    }
    .news-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .news-scroll::-webkit-scrollbar-thumb {
      background-color: var(--global-theme-color);
      border-radius: 3px;
    }
  </style>
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% if include.limit and site.announcements.scrollable and news_size > 3 %}
      {% assign news_scroll = true %}
    {% endif %}
    <div class="table-responsive{% if news_scroll %} news-scroll{% endif %}">
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%;">
                <span class="badge news-badge font-weight-bold align-middle" style="min-width: 75px"> {{ item.date | date: '%b %d, %Y' }}
                </span>
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if news_scroll %}
      <script>
        // Size the scroll box so exactly the latest 3 news items are visible
        (function () {
          const box = document.currentScript.previousElementSibling;
          const fit = () => {
            const rows = box.querySelectorAll("tr");
            let height = 0;
            for (let i = 0; i < Math.min(3, rows.length); i++) height += rows[i].offsetHeight;
            if (height > 0) box.style.maxHeight = height + 1 + "px";
          };
          fit();
          window.addEventListener("load", fit);
          window.addEventListener("resize", fit);
        })();
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
